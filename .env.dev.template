# settings for `slack run` against the dev workspace
# SLACK_BOT_TOKEN / SLACK_APP_TOKEN are injected by the Slack CLI; do not set them here

[slack.user]
# BOT_ID, SLACK_WORKSPACE_ID, SLACK_APP_ID (from .slack/apps.dev.json) and the #prd / #log channels are
# derived by scripts/slack_dev_bootstrap.py, so they must not be set here either

# the user that can use the reboot shortcut
ADMIN=UXXXX

[database]
DATABASE_URL=sqlite:///.db/dev.db
