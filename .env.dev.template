# settings for `slack run` against the dev workspace
# SLACK_BOT_TOKEN / SLACK_APP_TOKEN are injected by the Slack CLI; do not set them here

[slack.user]
# BOT_ID, SLACK_WORKSPACE_ID and the #prd / #log channels are derived from the dev app's token
# by scripts/slack_dev_bootstrap.py, so they must not be set here either
# legacy bots do not exist in the dev workspace; any unused ID works
V1_BOT_ID=B000000001
V2_BOT_ID=B000000002

# the user that can use the reboot shortcut
ADMIN=UXXXX

[database]
DATABASE_URL=sqlite:///.db/dev.db

[log]
LOGURU_LEVEL=DEBUG
