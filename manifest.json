{
  "display_information": {
    "name": "hikarie-bot-dev"
  },
  "features": {
    "bot_user": {
      "display_name": "hikarie-bot-dev",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    },
    "shortcuts": [
      {
        "name": "出社した",
        "type": "global",
        "callback_id": "arrive",
        "description": "今日の出社を登録する"
      },
      {
        "name": "reboot",
        "type": "message",
        "callback_id": "reboot",
        "description": "Reboot the bot (admin only)"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:history",
        "groups:history",
        "channels:read",
        "channels:join",
        "channels:manage",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
